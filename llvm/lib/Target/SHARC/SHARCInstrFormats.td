class SHARCInst<int width, dag outs, dag ins, string asm, list<dag> pat>
    : Instruction {
  let Namespace = "SHARC";
  let Size = !div(width, 8);
  let OutOperandList = outs;
  let InOperandList = ins;
  let AsmString = asm;
  let Pattern = pat;
  let hasSideEffects = 1;
}

class SHARCInst48<dag o, dag i, string a, list<dag> p>
    : SHARCInst<48, o, i, a, p> {
  field bits<48> Inst;
  field bits<48> SoftFail = 0;
}

class SHARCInst32<dag o, dag i, string a, list<dag> p>
    : SHARCInst<32, o, i, a, p> {
  field bits<32> Inst;
  field bits<32> SoftFail = 0;
}

class SHARCInst16<dag o, dag i, string a, list<dag> p>
    : SHARCInst<16, o, i, a, p> {
  field bits<16> Inst;
  field bits<16> SoftFail = 0;
}
