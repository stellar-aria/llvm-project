## Every documented instruction form from the encoding tables is defined once
## (a 48-bit form valid in both ISA and VISA code also gets a "_V" copy).
# RUN: llvm-tblgen -I %p/../../../include -I %p/../../../lib/Target/SHARC \
# RUN:   %p/../../../lib/Target/SHARC/SHARC.td --dump-json -o %t.json
# RUN: %python -c "import json,re,sys; d=json.load(open(sys.argv[1])); \
# RUN:   n=[k for k in d['!instanceof']['Instruction'] if re.match(r'T[0-9]', k)]; \
# RUN:   print(len(set(re.sub(r'_V$', '', x) for x in n)))" %t.json | FileCheck %s
# CHECK: {{^}}55{{$}}

## Every form has at least one top-level syntax row in SHARCFormSyntax.def.
# RUN: %python -c "import json,re,sys; d=json.load(open(sys.argv[1])); \
# RUN:   forms=sorted(k for k in d['!instanceof']['Instruction'] if re.match(r'T[0-9]', k)); \
# RUN:   rows=set(re.findall(r'^SHARC_SYNTAX\((\w+),', open(sys.argv[2]).read(), re.M)); \
# RUN:   print('syntax', 'ok' if rows == set(forms) else sorted(set(forms) ^ rows))" \
# RUN:   %t.json %p/../../../lib/Target/SHARC/SHARCFormSyntax.def | FileCheck %s --check-prefix=SYNTAX
# SYNTAX: syntax ok
